{
  "manifestVersion": 1,
  "id": "mineru-document-workbench",
  "name": "MinerU 文档解析",
  "version": "0.1.0",
  "description": "用 MinerU 解析 PDF、图片与 Office 文档，输出 Markdown 与 JSON，并可将结果直接引用到对话。",
  "minAppVersion": "0.159.0",
  "trust": "full-access",
  "capabilities": [
    "network.fetch",
    "resource.materialize",
    "model.sample",
    "provider.read",
    "agent.write"
  ],
  "network": {
    "allowedHosts": ["mineru.net", "*.openxlab.org.cn", "*.aliyuncs.com"],
    "methods": ["GET", "POST", "PUT"],
    "defaultTimeoutMs": 60000,
    "maxResponseBytes": 52428800
  },
  "ui": {
    "hostCapabilities": [
      "clipboard.writeText",
      "resource.pick"
    ]
  },
  "contributes": {
    "configuration": {
      "title": "MinerU 文档解析设置",
      "properties": {
        "apiBaseUrl": {
          "type": "string",
          "default": "https://mineru.net",
          "title": "API 地址",
          "description": "MinerU 服务地址，一般无需修改。"
        },
        "apiToken": {
          "type": "string",
          "sensitive": false,
          "title": "API Token",
          "description": "MinerU 的 Bearer Token，在此直接可见，方便核对与复制。选择「MinerU VLM」或「MinerU」时需要填写；选择「Agent 轻量解析 API」时可留空。"
        },
        "modelVersion": {
          "type": "string",
          "enum": ["vlm", "pipeline", "agent"],
          "default": "vlm",
          "title": "默认解析方式",
          "description": "vlm / pipeline 走 MinerU 精准解析 API（需 Token）；agent 走 Agent 轻量解析 API（免 Token，≤10MB、≤20 页、仅 Markdown）。也可在插件页面上临时选择。"
        },
        "pollIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 1000,
          "maximum": 30000,
          "title": "轮询间隔（毫秒）",
          "description": "保留参数，供后续轮询逻辑使用。"
        },
        "pollTimeoutMs": {
          "type": "number",
          "default": 600000,
          "minimum": 10000,
          "maximum": 1800000,
          "title": "轮询超时（毫秒）",
          "description": "保留参数，供后续轮询逻辑使用。"
        },
        "translationTargetLanguage": {
          "type": "string",
          "enum": [
            "中文",
            "繁体中文",
            "英语",
            "日语",
            "韩语",
            "法语",
            "德语",
            "西班牙语",
            "葡萄牙语",
            "意大利语",
            "俄语",
            "阿拉伯语",
            "泰语",
            "越南语"
          ],
          "default": "中文",
          "title": "默认目标语言",
          "description": "翻译时翻成的语言。插件页面上的语言列表与此保持一致。"
        }
      }
    },
    "page": {
      "title": "MinerU",
      "route": "/page",
      "icon": "<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g transform=\"translate(12 12) scale(0.85) translate(-12 -12)\"><circle cx=\"18.4427\" cy=\"3.86898\" r=\"1.2811\" fill=\"currentColor\"/><circle cx=\"14.087\" cy=\"5.1491\" r=\"1.2811\" fill=\"currentColor\"/><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8.05175 11.2368C8.05175 13.4605 9.14375 15.4293 10.8211 16.6371C11.8241 15.7389 12.4551 14.4345 12.4551 12.9828V9.39673C12.4551 8.85661 12.8197 8.38448 13.3426 8.24757L19.8924 6.53265C20.6459 6.33534 21.3826 6.90341 21.3826 7.6818L21.3826 12.0452C21.3826 17.2179 17.1861 21.4111 12.0095 21.4111L11.9942 21.4111C6.81758 21.4111 2.62109 17.2179 2.62109 12.0452V9.03388C2.62109 8.49175 2.9884 8.01839 3.51385 7.88336L6.56677 7.09882C7.31904 6.9055 8.05175 7.47318 8.05175 8.24934V11.2368ZM3.9798 12.0452C3.9798 13.8476 4.57565 15.5108 5.58124 16.849C6.04996 17.4728 6.7655 17.8884 7.54573 17.8884V17.8884C8.28848 17.8884 8.9927 17.7236 9.62376 17.4286C7.83439 15.9596 6.69304 13.7314 6.69304 11.2368V8.46821L3.9798 9.16546V12.0452Z\" fill=\"currentColor\"/></g></svg>"
    },
    "widget": {
      "title": "MinerU",
      "route": "/widget",
      "icon": "<svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><g transform=\"translate(12 12) scale(0.85) translate(-12 -12)\"><circle cx=\"18.4427\" cy=\"3.86898\" r=\"1.2811\" fill=\"currentColor\"/><circle cx=\"14.087\" cy=\"5.1491\" r=\"1.2811\" fill=\"currentColor\"/><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8.05175 11.2368C8.05175 13.4605 9.14375 15.4293 10.8211 16.6371C11.8241 15.7389 12.4551 14.4345 12.4551 12.9828V9.39673C12.4551 8.85661 12.8197 8.38448 13.3426 8.24757L19.8924 6.53265C20.6459 6.33534 21.3826 6.90341 21.3826 7.6818L21.3826 12.0452C21.3826 17.2179 17.1861 21.4111 12.0095 21.4111L11.9942 21.4111C6.81758 21.4111 2.62109 17.2179 2.62109 12.0452V9.03388C2.62109 8.49175 2.9884 8.01839 3.51385 7.88336L6.56677 7.09882C7.31904 6.9055 8.05175 7.47318 8.05175 8.24934V11.2368ZM3.9798 12.0452C3.9798 13.8476 4.57565 15.5108 5.58124 16.849C6.04996 17.4728 6.7655 17.8884 7.54573 17.8884V17.8884C8.28848 17.8884 8.9927 17.7236 9.62376 17.4286C7.83439 15.9596 6.69304 13.7314 6.69304 11.2368V8.46821L3.9798 9.16546V12.0452Z\" fill=\"currentColor\"/></g></svg>"
    }
  },
  "dev": {
    "scenarios": [
      {
        "id": "open-page",
        "steps": [
          {
            "openSurface": "/page"
          }
        ]
      }
    ]
  }
}
